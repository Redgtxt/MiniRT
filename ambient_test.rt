# Test scene to demonstrate ambient lighting with SOLID textures

# Strong ambient light to clearly see the effect
A					0.8					255,255,255

# Camera positioned to view the scene
C 	0,0,5						0,0,-1	70

# No direct lights - only ambient should illuminate the spheres
# (Comment out to test pure ambient lighting)
L 	5,5,5				0.5				255,255,255

# Spheres with SOLID textures - should be visible with ambient light only
sp 	-2,0,0		    1 							255,100,100		SOLID
sp 	0,0,0		    1 							100,255,100		SOLID  
sp 	2,0,0		    1 							100,100,255		SOLID

# Different materials for comparison
sp 	-2,-2.5,0		0.8 						255,100,100		LAMBERTIAN
sp 	0,-2.5,0		0.8 						100,255,100		LAMBERTIAN
sp 	2,-2.5,0		0.8 						100,100,255		LAMBERTIAN