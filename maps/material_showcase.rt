# MiniRT Material Showcase - All Objects with All Materials
# This scene demonstrates how each material type looks on different geometric objects

# Moderate ambient light for base illumination
A					0.15				255,255,255

# Camera positioned to see the full showcase
C 	0,2,6						0,-0.4,-1	60

# Primary light source from upper right
L 	4,5,3				1.0				255,255,240

# Secondary light source from left for fill lighting
L 	-3,3,4				0.6				200,220,255

# === PLANES ===

# Left side plane - LAMBERTIAN
pl 	-6,0,0			1,0,0 						255,200,100 	LAMBERTIAN

# Right side plane - METAL  
pl 	6,0,0			-1,0,0 						255,200,100 	METAL

# Ground plane with SOLID material
pl 	0,-2.5,0			0,1,0 						120,120,120 	CHECKERPATTERN

# Back wall for reference
pl 	0,0,-4			0,0,1 						100,100,120 	SOLID

# === ROW 1: SPHERES ===
# LAMBERTIAN sphere
sp 	-4,1,0		    0.8 							255,100,100		LAMBERTIAN

# METAL sphere  
sp 	-2,1,0		    0.8 							255,100,100		METAL

# CHECKERPATTERN sphere
sp 	0,1,0		    0.8 							255,100,100		CHECKERPATTERN

# GLASS sphere
sp 	2,1,0		    0.8 							255,100,100		GLASS

# SOLID sphere
sp 	4,1,0		    0.8 							255,100,100		SOLID

# === ROW 2: CYLINDERS ===
# LAMBERTIAN cylinder
cy 	-4,-0.5,0		0,1,0		0.6	2		100,255,100 	LAMBERTIAN

# METAL cylinder
cy 	-2,-0.5,0		0,1,0		0.6	2		100,255,100 	METAL

# CHECKERPATTERN cylinder  
cy 	0,-0.5,0		0,1,0		0.6	2		100,255,100 	CHECKERPATTERN

# GLASS cylinder
cy 	2,-0.5,0		0,1,0		0.6	2		100,255,100 	GLASS

# SOLID cylinder
cy 	4,-0.5,0		0,1,0		0.6	2		100,255,100 	SOLID

# === ROW 3: CONES ===
# LAMBERTIAN cone
cn 	-4,-2,0		0,1,0		0.8	1.5		100,100,255 	LAMBERTIAN

# METAL cone
cn 	-2,-2,0		0,1,0		0.8	1.5		100,100,255 	METAL

# CHECKERPATTERN cone
cn 	0,-2,0		0,1,0		0.8	1.5		100,100,255 	CHECKERPATTERN

# GLASS cone
cn 	2,-2,0		0,1,0		0.8	1.5		100,100,255 	GLASS

# SOLID cone  
cn 	4,-2,0		0,1,0		0.8	1.5		100,100,255 	SOLID
