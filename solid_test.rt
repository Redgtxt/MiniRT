# MiniRT Scene File - Testing Solid Textures
# This scene demonstrates solid textures with proper lighting interaction

# Ambient light - soft background illumination
A					0.3					255,255,255

# Camera positioned to view the scene
C 	0,0,5						0,0,-1	70

# Primary light source - warm white light
L 	2111,2,2				0.8				255,255,200

# Secondary light source - cool blue light for contrast
L 	-1112,1,3				0.4				100,150,255

# Spheres with SOLID textures
sp 	-1.5,0,0		    0.8 							255,100,100		SOLID
sp 	0,0,0		    	0.8 							100,255,100		SOLID
sp 	1.5,0,0		    	0.8 							100,100,255		SOLID

# Additional spheres at different heights to show lighting variation
sp 	-1,1.5,0		    0.6 							255,255,100		SOLID
sp 	1,1.5,0		    	0.6 							255,100,255		SOLID

# # Ground plane with solid texture
pl 	0,-1.5,0			0,1,0 						200,200,200 	SOLID

# # Back wall with solid texture for depth
pl 	0,0,-3			0,0,1 						150,150,200 	SOLID