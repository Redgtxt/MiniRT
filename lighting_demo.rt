# Demonstration: Ambient vs Directional Lighting Effects

# Moderate ambient light
A					0.2					255,255,255

# Camera
C 	0,0,5						0,0,-1	70

# CLOSE directional light to create shadows and depth
L 	3,3,2				1.0				255,255,255

# Row 1: SOLID materials (should show clear 3D shape with directional light)
sp 	-2,1,0		    0.8 							255,100,100		SOLID
sp 	0,1,0		    0.8 							100,255,100		SOLID
sp 	2,1,0		    0.8 							100,100,255		SOLID

# Row 2: LAMBERTIAN for comparison  
sp 	-2,-1,0		    0.8 							255,100,100		LAMBERTIAN
sp 	0,-1,0		    0.8 							100,255,100		LAMBERTIAN
sp 	2,-1,0		    0.8 							100,100,255		LAMBERTIAN

# Ground plane to show shadows
pl 	0,-2,0			0,1,0 						200,200,200 	SOLID